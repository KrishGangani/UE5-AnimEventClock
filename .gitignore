# P06_AnimEventClock repository: docs + the UE project in AnimEventClock/.
# Generated by Unreal / Visual Studio. Never commit.
AnimEventClock/Binaries/
AnimEventClock/Intermediate/
AnimEventClock/Saved/
AnimEventClock/DerivedDataCache/
AnimEventClock/Build/
AnimEventClock/Plugins/*/Binaries/
AnimEventClock/Plugins/*/Intermediate/
AnimEventClock/.vs/
AnimEventClock/*.sln
AnimEventClock/*.slnx
*.VC.db
*.opensdf
*.sdf
*.suo

# Python
__pycache__/

# Packaged builds stay out of git.
Build/

# Benchmarks: raw captures, run reports and logs stay local (too large for git; UE logs also hold
# machine-specific paths). Manifests and Summaries/ are committed; cited raw batches go to GitHub Releases.
Benchmarks/Raw/*
!Benchmarks/Raw/*_manifest.json
Benchmarks/*_console.txt

# Parked drafts and downloaded reference files (never committed; AGENT_BRIEF rule 11).
_wip/
